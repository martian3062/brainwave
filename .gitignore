.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local SQLite fallback database (Postgres on Render).
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

