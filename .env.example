# ERAYA x BRAINWAVE -- environment.
#
# Every value below is a DEFAULT that the app already uses. Copy to .env only to
# change something: a fresh clone runs with no .env at all (SQLite on disk, Base
# Sepolia, the public x402 facilitator, safe per-call settlement).
#
#   cp .env.example .env

# =============================================================================
# App
# =============================================================================
APP_NAME="ERAYA x BRAINWAVE"
APP_ENV=local                       # local | staging | production
DEBUG=false
LOG_LEVEL=INFO

# Public origin. Two things depend on it, and both fail loudly if it is wrong:
#  - the MCP endpoint URL advertised to agents
#  - the MCP transport host allowlist (see MCP_ALLOWED_HOSTS below)
PUBLIC_BASE_URL=http://localhost:8000

# Signs NiceGUI's session cookie. MUST be changed for production -- app.main
# refuses to start with the default when APP_ENV=production.
STORAGE_SECRET=dev-only-change-me

# =============================================================================
# Database
# =============================================================================
# SQLite fallback: no Postgres needed to run locally. Render injects a
# postgresql:// URL; app/db.py rewrites the legacy postgres:// scheme that
# SQLAlchemy 2 rejects. No dj-database-url -- SQLAlchemy parses the URL itself.
DATABASE_URL=sqlite:///./brainwave.db
# DATABASE_URL=postgresql://user:pass@host:5432/brainwave
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =============================================================================
# x402
# =============================================================================
# CAIP-2 ONLY. x402 v2 dropped the v1 "base-sepolia" spelling; the app refuses
# anything without a colon.
#   Base mainnet  eip155:8453
#   Base Sepolia  eip155:84532
X402_NETWORK=eip155:84532

# Blank = use the network's canonical USDC from x402's own NETWORK_CONFIGS table
#   eip155:8453   0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   eip155:84532  0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_ASSET=
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
X402_ASSET_NAME=USDC                # EIP-712 domain name, needed to sign EIP-3009
X402_ASSET_VERSION=2

FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_LABEL=x402.org
# Coinbase CDP hosted facilitator. Optional -- the public facilitator above
# needs no credentials on testnet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Where tool revenue lands when an Author row does not override it.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
# Platform take, basis points. 1000 = 10%.
PLATFORM_TAKE_BPS=1000

# What ONE on-chain settlement costs at the facilitator. This is the number the
# entire economic argument turns on: at a $0.002 tool price, settling every call
# burns 50% of revenue; amortised over a 100-call session it is 0.5%.
# CDP: first 1,000 tx/month free, then $0.001 each.
FACILITATOR_FEE_PRICE=$0.001
FACILITATOR_FREE_TX_PER_MONTH=1000

PAYMENT_TIMEOUT_SECONDS=300

# =============================================================================
# Session settlement
# =============================================================================
# Safe default: exact and upto authorizations settle immediately. Enable this
# only when using the SDK's batch-settlement channel scheme end to end.
BATCHING_ENABLED=false
# Signed cumulative vouchers are encrypted with STORAGE_SECRET and stored
# outside the six reporting ledger tables. Use memory only for disposable tests.
CHANNEL_STORAGE_BACKEND=database
BATCH_WINDOW_SECONDS=300
BATCH_MAX_CALLS=500
# Do not open an on-chain settlement for dust; roll it into the next batch.
BATCH_MIN_GROSS_PRICE=$0.01

# =============================================================================
# Buyer side -- the demo agent and its Guardian
# =============================================================================
# NEVER a funded mainnet key.
AGENT_WALLET_KEY=

# Guardian policy. Evaluated locally, BEFORE any signature exists -- a payment
# that was never signed cannot be settled, which is why this belongs to the
# buyer and not to the seller.
SESSION_BUDGET=$5.00
PER_CALL_MAX=$0.10
DAILY_BUDGET=$50.00
ESCALATE_ABOVE=$1.00
REQUIRE_RECEIPT=true
ALLOWLIST=mcp://*

# =============================================================================
# MCP transport
# =============================================================================
MCP_SERVER_NAME=eraya-brainwave
MCP_MOUNT_PATH=/mcp
# Stateless: no server-side MCP session affinity, so the single Render web
# service can restart without stranding clients. Payment sessions are OUR
# concept and live in Postgres, not in the MCP transport.
MCP_STATELESS=true
MCP_JSON_RESPONSE=true

# mcp==1.28.1 enables DNS-rebinding protection BY DEFAULT and allows only
# localhost. Deployed to *.onrender.com, every MCP request 421s with
# "Invalid Host header" unless the deploy host is allowed. The host derived from
# PUBLIC_BASE_URL is added automatically; list extras here, comma-separated.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_DNS_REBINDING_PROTECTION=true

# =============================================================================
# Ledger admin (SQLAdmin)
# =============================================================================
ADMIN_ENABLED=true
ADMIN_PATH=/admin
ADMIN_USERNAME=admin
# Empty = no login form. Fine locally; app.main refuses to start with an empty
# password when APP_ENV=production.
ADMIN_PASSWORD=

# =============================================================================
# Paid tool catalogue (app/gateway)
#
# Everything below describes what the TOOLS may reach. None of it is part of the
# payment spine, and every value has a default that lets the gateway boot and
# sell with this whole section deleted -- tools that need a missing dependency
# report themselves unavailable and capture nothing rather than raising.
# =============================================================================
CATALOGUE_AUTHOR_SLUG=eraya
CATALOGUE_AUTHOR_NAME=ERAYA Swarm
# Re-sync tool prices from code on every boot. Turn OFF to make the database
# authoritative so an operator can reprice from /admin without a redeploy --
# note the live 402 challenge still advertises the boot-time price until the
# next restart, and list_paid_tools flags the drift when they disagree.
CATALOGUE_SYNC_PRICES=true

# --- Swarm simulations -------------------------------------------------------
# Base URL of a running ERAYA backend, e.g. https://host/eraya_api
# EMPTY (the default) is a supported mode, not a broken one: the injection and
# spoof simulations then run their pipeline in THIS process and label the result
# engine="local". Only ever point this at a host you operate.
ERAYA_API_BASE=
ERAYA_API_TIMEOUT=15
# HMAC key the local pipeline signs its verdicts with. Change it in production:
# the signature is what makes an audit record tamper-evident.
ERAYA_AUDIT_KEY=dev-audit-key

# --- Casper chain reads ------------------------------------------------------
# Read-only. The gateway holds no Casper key, signs nothing and submits nothing.
CASPER_NODE_RPC_URL=https://node.testnet.casper.network/rpc
CASPER_CHAIN_NAME=casper-test
CASPER_EXPLORER_BASE=https://testnet.cspr.live
# Default account for casper_balance when the caller omits one.
CASPER_PUBLIC_KEY=
CASPER_RPC_TIMEOUT=15

# --- analyze_contract (the metered tool) -------------------------------------
# Without a key the tool reports itself unavailable and captures only its base
# price. It never charges the ceiling for an answer it could not produce.
ANTHROPIC_API_KEY=
# Thinking is ON BY DEFAULT on claude-opus-5 and ANALYSIS_MAX_TOKENS caps
# thinking AND response text together -- size it for both.
ANALYSIS_MODEL=claude-opus-5
ANALYSIS_MAX_TOKENS=8000
ANALYSIS_EFFORT=medium
ANALYSIS_TIMEOUT=120
# Refuse oversized input rather than truncate it: silently reviewing two thirds
# of a contract and charging for it is the worst available outcome.
ANALYSIS_MAX_INPUT_CHARS=60000

# --- Prices (human units; parsed once to integer atomic units) ---------------
PRICE_INJECTION_SIM=$0.01
PRICE_CASPER_READ=$0.001
PRICE_SUMMARIZE_BUG_REPORT=$0.001
# analyze_contract is `upto`: the ceiling the agent authorizes...
PRICE_ANALYZE_CONTRACT_MAX=$0.05
# ...the part charged unconditionally once the model runs...
PRICE_ANALYZE_CONTRACT_BASE=$0.002
# ...and the metered part, per 1k tokens (input + output). Floored to a whole
# atomic unit per token, so rounding can only ever favour the payer.
PRICE_ANALYZE_CONTRACT_PER_KTOK=$0.004
